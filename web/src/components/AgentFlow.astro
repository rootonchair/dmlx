---
// One chat message, start to finish, as the engine does it:
//   engine/src/dmlx/prompting/agent.py  (what the agent sees, its look/read_chat tools, the plan and its checks)
//   engine/src/dmlx/engine.py           (unload the agent, memory plan, run the image job)
// Two lanes (the agent, then the image job) with a running example. Wide on desktop, stacked on phones.
type Stage = { n: number; title: string; tag?: string; items: [string, string][]; eg: string };
const agent: Stage[] = [
  {
    n: 1, title: 'Reads the chat', items: [
      ['Your message', 'and the recent lines of the chat'],
      ['The latest image', 'or the images you attached'],
      ['Every image', 'in the chat, listed with its prompt'],
      ['The models', 'it may pick, and the free memory'],
    ], eg: '"make the boat red" · it sees image 2, a teapot',
  },
  {
    n: 2, title: 'Looks closer', tag: 'if it needs to', items: [
      ['Look', 'opens up to 3 older images, twice at most'],
      ['Read', 'the whole chat when the recent lines aren’t enough'],
      ['Resolves', '"it", "the first one", "undo the hat"'],
      ['Trusts', 'what it sees over an old prompt'],
    ], eg: 'looks at image 1 · a rowboat',
  },
  {
    n: 3, title: 'Decides and writes', items: [
      ['New image', 'a full description, 40–120 words'],
      ['Edit', 'the image to change, up to 2 references, one clear instruction, then a detailed description of the result'],
      ['Model', 'on Auto, the one that fits the job, its speed and the free memory'],
      ['Or', 'one short question when unsure, or a reply when you’re just talking'],
    ], eg: 'edit image 1 · "Make the wooden rowboat red" · FLUX.2 Klein 4B',
  },
];
const job: Stage[] = [
  {
    n: 4, title: 'Checks the plan', tag: 'plain code', items: [
      ['Images', 'exist in the chat; an edit has one; 3 at most'],
      ['Models', 'it wasn’t offered are ignored'],
      ['Retry', 'a plan that fails is sent back once, with the reason'],
      ['Fallback', 'then simple rules take over'],
    ], eg: 'image 1 exists · edit is possible',
  },
  {
    n: 5, title: 'Makes the image', items: [
      ['Unload', 'the agent leaves memory first'],
      ['Memory check', 'loads the model all at once, in phases, or piece by piece'],
      ['Not enough', 'it doesn’t start: Retry, or Try anyway'],
      ['Result', 'a new image, or a new version of one'],
    ], eg: 'Image 3 · edited from image 1',
  },
];
const lanes = [
  { name: 'The agent', note: 'on your Mac · about 3–10 s', stages: agent, cls: 'lane-agent' },
  { name: 'The image job', note: 'after the plan', stages: job, cls: 'lane-job' },
];
---
<figure class="flow" aria-labelledby="flow-cap">
  <div class="lanes">
    {lanes.map((lane) => (
      <div class:list={['lane', lane.cls]} role="group" aria-label={lane.name}>
        <h4 class="lane-h"><b>{lane.name}</b><span>{lane.note}</span></h4>
        <ol class="stages" style={`--cols:${lane.stages.length}`}>
          {lane.stages.map((s) => (
            <li class="stage" data-i={s.n - 1}>
              <div class="st-h"><span class="num">{s.n}</span><h5>{s.title}</h5></div>
              {s.tag && <em class="tag">{s.tag}</em>}
              <dl>{s.items.map(([k, v]) => <div><dt>{k}</dt><dd>{v}</dd></div>)}</dl>
              <p class="eg"><span>e.g.</span>{s.eg}</p>
            </li>
          ))}
        </ol>
      </div>
    ))}
  </div>
  <figcaption id="flow-cap">One message, start to finish. The agent makes the choices; plain code only refuses what can’t run.</figcaption>
</figure>

<style>
  .flow { margin: 72px 0 0; display: grid; gap: 16px }
  .lanes { display: grid; grid-template-columns: 3fr 2fr; gap: 28px }
  .lane { display: grid; grid-template-rows: auto 1fr }
  .lane-h { display: flex; flex-wrap: wrap; align-items: baseline; gap: 4px 10px; margin: 0 0 12px; padding-top: 10px; border-top: 2px solid var(--line); font: 500 .78rem var(--mono); letter-spacing: .06em; text-transform: uppercase; color: var(--muted) }
  .lane-h b { color: var(--fg); font-weight: 600 }
  .lane.lane-agent .lane-h { border-top-color: var(--accent) }
  .lane.lane-agent .lane-h b { color: var(--accent) }
  .stages { list-style: none; margin: 0; padding: 0; display: grid; grid-template-columns: repeat(var(--cols), minmax(0, 1fr)); gap: 28px }
  .stage { position: relative; display: flex; flex-direction: column; gap: 12px; padding: 16px; border: 1px solid var(--line); border-radius: 12px; background: var(--raise) }
  .lane-agent .stage { background: color-mix(in srgb, var(--accent) 7%, var(--raise)); border-color: color-mix(in srgb, var(--accent) 35%, var(--line)) }
  /* An arrow in the gap after every stage but the very last one. */
  .stage::after { content: ''; position: absolute; top: 26px; right: -22px; width: 16px; height: 10px; background: var(--muted);
    clip-path: polygon(0 40%, 62% 40%, 62% 0, 100% 50%, 62% 100%, 62% 60%, 0 60%) }
  .lane-job .stage:last-child::after { display: none }
  .st-h { display: flex; align-items: center; gap: 8px; flex-wrap: wrap }
  .num { display: grid; place-items: center; width: 22px; height: 22px; border-radius: 50%; background: var(--accent); color: var(--accent-ink); font: 600 .75rem var(--mono); flex: none }
  .lane-job .num { background: var(--fg); color: var(--bg) }
  h5 { flex: 1 1 0; min-width: 0; margin: 0; font: 600 1rem/1.3 var(--body); color: var(--fg) }
  .tag { align-self: flex-start; margin: -6px 0 0 30px;  font: normal .7rem var(--mono); color: var(--muted); border: 1px solid var(--line); border-radius: 99px; padding: 1px 7px }
  dl { margin: 0; display: grid; gap: 8px; align-content: start }
  dl div { font-size: .86rem; line-height: 1.4; color: var(--muted) }
  dt { display: inline; color: var(--fg); font-weight: 600 }
  dt::after { content: ' ' }
  dd { display: inline; margin: 0 }
  .eg { margin: auto 0 0; padding-top: 10px; border-top: 1px dashed var(--line); font: .76rem/1.45 var(--mono); color: var(--accent) }
  .eg span { color: var(--muted); margin-right: 6px }
  .flow figcaption { font: .85rem var(--mono); color: var(--muted); text-align: center }

  /* Narrower: each lane gets the full width. */
  @media (max-width: 1060px) {
    .lanes { grid-template-columns: 1fr }
    .lane-agent .stage:last-child::after { top: auto; bottom: -50px; right: auto; left: 50%; transform: translateX(-50%) rotate(90deg) }
  }
  /* Phones: one column, arrows point down. */
  @media (max-width: 700px) {
    .stages { grid-template-columns: 1fr; gap: 26px }
    .stage::after, .lane-agent .stage:last-child::after { top: auto; bottom: -19px; right: auto; left: 28px; transform: rotate(90deg) }
  }
</style>
